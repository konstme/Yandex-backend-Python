#Напишите программу, которая определяет:
#• является ли вводимое целое число число
#чётным/нечётным;
#• положительное/отрицательное/ноль;
#• принадлежит ли диапазону [10, 50].

num = int(input("Введите число: "))
if num % 2 == 0:
    print(f"{num} - чётное число")
else:
    print(f"{num} - нечётное число")
if num > 0:
    print(f"{num} - положительное число")
elif num < 0:
    print(f"{num} - отрицательное число")
else:
    print(f"{num} - ноль")
if 10 <= num <= 50:
    print(f"{num} принадлежит диапазону [10, 50]")
else:
    print(f"{num} не принадлежит диапазону [10, 50]")

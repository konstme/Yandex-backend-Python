#Условие: Напишите программу, которая переводит
#температуру из градусов Цельсия в Фаренгейты и
#Кельвины и выводит на экран две строки с данными о
#температурах следующего формата:

cel = int(input("Введите температуру в цельсиях: "))
fahr = (cel * 9/5) + 32
kel = cel + 273.15
print(f"Температура в Фаренгейтах: {fahr}")
print(f"Температура в Кельвинах: {kel}")
